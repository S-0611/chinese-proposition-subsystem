{
  "items": [
    {"id": "L1-124", "level": 1, "round": 2, "text": "六月一日是我的生日。", "pinyin": "liùyuè yī rì shì wǒ de shēngrì.", "grammar": ["G1-38", "G1-01", "G1-28"]},
    {"id": "L1-125", "level": 1, "round": 2, "text": "一件衣服九百块钱。", "pinyin": "yí jiàn yīfu jiǔbǎi kuài qián.", "grammar": ["G1-35", "G1-39"]},
    {"id": "L1-126", "level": 1, "round": 2, "text": "我们学校有一万个学生。", "pinyin": "wǒmen xuéxiào yǒu yí wàn ge xuésheng.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-127", "level": 1, "round": 2, "text": "我买了两本书。", "pinyin": "wǒ mǎi le liǎng běn shū.", "grammar": ["G1-35", "G1-29"]},
    {"id": "L1-128", "level": 1, "round": 2, "text": "一支笔一块钱。", "pinyin": "yì zhī bǐ yí kuài qián.", "grammar": ["G1-35", "G1-39"]},
    {"id": "L1-129", "level": 1, "round": 2, "text": "九月一日开学。", "pinyin": "jiǔyuè yī rì kāixué.", "grammar": ["G1-38"]},
    {"id": "L1-130", "level": 1, "round": 2, "text": "你什么时候回家？", "pinyin": "nǐ shénme shíhou huí jiā?", "grammar": ["G1-04"]},
    {"id": "L1-131", "level": 1, "round": 2, "text": "它是我的猫。", "pinyin": "tā shì wǒ de māo.", "grammar": ["G1-01", "G1-28"]},
    {"id": "L1-132", "level": 1, "round": 2, "text": "我自己去商店买东西。", "pinyin": "wǒ zìjǐ qù shāngdiàn mǎi dōngxi.", "grammar": ["G1-40"]},
    {"id": "L1-133", "level": 1, "round": 2, "text": "王先生是我的汉语老师。", "pinyin": "Wáng xiānsheng shì wǒ de Hànyǔ lǎoshī.", "grammar": ["G1-01", "G1-28"]},
    {"id": "L1-134", "level": 1, "round": 2, "text": "那个孩子很可爱。", "pinyin": "nà ge háizi hěn kě'ài.", "grammar": ["G1-13", "G1-35"]},
    {"id": "L1-135", "level": 1, "round": 2, "text": "你的名字很好听。", "pinyin": "nǐ de míngzi hěn hǎotīng.", "grammar": ["G1-13", "G1-28"]},
    {"id": "L1-136", "level": 1, "round": 2, "text": "你问我答，好不好？", "pinyin": "nǐ wèn wǒ dá, hǎo bu hǎo?", "grammar": ["G1-05"]},
    {"id": "L1-137", "level": 1, "round": 2, "text": "每天我们都写汉字。", "pinyin": "měitiān wǒmen dōu xiě Hànzì.", "grammar": ["G1-23", "G1-17"]},
    {"id": "L1-138", "level": 1, "round": 2, "text": "我忘了你的名字。", "pinyin": "wǒ wàng le nǐ de míngzi.", "grammar": ["G1-29", "G1-28"]},
    {"id": "L1-139", "level": 1, "round": 2, "text": "请你记住我的名字。", "pinyin": "qǐng nǐ jìzhù wǒ de míngzi.", "grammar": ["G1-09"]},
    {"id": "L1-140", "level": 1, "round": 2, "text": "我知道了。", "pinyin": "wǒ zhīdào le.", "grammar": ["G1-29"]},
    {"id": "L1-141", "level": 1, "round": 2, "text": "你会用电脑吗？", "pinyin": "nǐ huì yòng diànnǎo ma?", "grammar": ["G1-31", "G1-03"]},
    {"id": "L1-142", "level": 1, "round": 2, "text": "请帮我拿一下。", "pinyin": "qǐng bāng wǒ ná yíxià.", "grammar": ["G1-09"]},
    {"id": "L1-143", "level": 1, "round": 2, "text": "他送我一本书。", "pinyin": "tā sòng wǒ yì běn shū.", "grammar": ["G1-41", "G1-35"]},
    {"id": "L1-144", "level": 1, "round": 2, "text": "妈妈让我去买菜。", "pinyin": "māma ràng wǒ qù mǎi cài.", "grammar": ["G1-40"]},
    {"id": "L1-145", "level": 1, "round": 2, "text": "你叫什么名字？", "pinyin": "nǐ jiào shénme míngzi?", "grammar": ["G1-04"]},
    {"id": "L1-146", "level": 1, "round": 2, "text": "我住在学校宿舍。", "pinyin": "wǒ zhù zài xuéxiào sùshè.", "grammar": ["G1-24"]},
    {"id": "L1-147", "level": 1, "round": 2, "text": "我们班有十个学生。", "pinyin": "wǒmen bān yǒu shí ge xuésheng.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-148", "level": 1, "round": 2, "text": "我家旁边有一家医院。", "pinyin": "wǒ jiā pángbian yǒu yì jiā yīyuàn.", "grammar": ["G1-02"]},
    {"id": "L1-149", "level": 1, "round": 2, "text": "饭馆的菜很好吃。", "pinyin": "fànguǎn de cài hěn hǎochī.", "grammar": ["G1-28", "G1-13"]},
    {"id": "L1-150", "level": 1, "round": 2, "text": "我买了一支笔。", "pinyin": "wǒ mǎi le yì zhī bǐ.", "grammar": ["G1-29", "G1-35"]},
    {"id": "L1-151", "level": 1, "round": 2, "text": "我的包是新的。", "pinyin": "wǒ de bāo shì xīn de.", "grammar": ["G1-01", "G1-28"]},
    {"id": "L1-152", "level": 1, "round": 2, "text": "这块手表多少钱？", "pinyin": "zhè kuài shǒubiǎo duōshao qián?", "grammar": ["G1-06", "G1-39", "G1-35"]},
    {"id": "L1-153", "level": 1, "round": 2, "text": "他在医院工作。", "pinyin": "tā zài yīyuàn gōngzuò.", "grammar": ["G1-24"]},
    {"id": "L1-154", "level": 1, "round": 2, "text": "飞机很快。", "pinyin": "fēijī hěn kuài.", "grammar": ["G1-13"]},
    {"id": "L1-155", "level": 1, "round": 2, "text": "我坐飞机去北京看妈妈。", "pinyin": "wǒ zuò fēijī qù Běijīng kàn māma.", "grammar": ["G1-40"]},
    {"id": "L1-156", "level": 1, "round": 2, "text": "我早上吃了一个蛋。", "pinyin": "wǒ zǎoshang chī le yí ge dàn.", "grammar": ["G1-29", "G1-35"]},
    {"id": "L1-157", "level": 1, "round": 2, "text": "我不吃肉。", "pinyin": "wǒ bù chī ròu.", "grammar": ["G1-14"]},
    {"id": "L1-158", "level": 1, "round": 2, "text": "我妹妹很喜欢吃糖。", "pinyin": "wǒ mèimei hěn xǐhuan chī táng.", "grammar": ["G1-13"]},
    {"id": "L1-159", "level": 1, "round": 2, "text": "右边是医院，左边是学校。", "pinyin": "yòubian shì yīyuàn, zuǒbian shì xuéxiào.", "grammar": ["G1-01"]},
    {"id": "L1-160", "level": 1, "round": 2, "text": "前面是汽车站，后面是银行。", "pinyin": "qiánmian shì qìchēzhàn, hòumian shì yínháng.", "grammar": ["G1-01"]},
    {"id": "L1-161", "level": 1, "round": 2, "text": "冬天下雪了。", "pinyin": "dōngtiān xià xuě le.", "grammar": ["G1-29"]},
    {"id": "L1-162", "level": 1, "round": 2, "text": "下雨了，快回家吧。", "pinyin": "xià yǔ le, kuài huí jiā ba.", "grammar": ["G1-29"]},
    {"id": "L1-163", "level": 1, "round": 2, "text": "可乐很凉。", "pinyin": "kělè hěn liáng.", "grammar": ["G1-13"]},
    {"id": "L1-164", "level": 1, "round": 2, "text": "从学校到公园很远。", "pinyin": "cóng xuéxiào dào gōngyuán hěn yuǎn.", "grammar": ["G1-25"]},
    {"id": "L1-165", "level": 1, "round": 2, "text": "那只小狗是黑的。", "pinyin": "nà zhī xiǎo gǒu shì hēi de.", "grammar": ["G1-01", "G1-28", "G1-35"]},
    {"id": "L1-166", "level": 1, "round": 2, "text": "她很喜欢红衣服。", "pinyin": "tā hěn xǐhuan hóng yīfu.", "grammar": ["G1-13"]},
    {"id": "L1-167", "level": 1, "round": 2, "text": "我想喝绿茶。", "pinyin": "wǒ xiǎng hē lǜchá.", "grammar": ["G1-33"]},
    {"id": "L1-168", "level": 1, "round": 2, "text": "对不起，我错了。", "pinyin": "duìbuqǐ, wǒ cuò le.", "grammar": ["G1-14", "G1-29"]},
    {"id": "L1-169", "level": 1, "round": 2, "text": "生日快乐！真高兴！", "pinyin": "shēngrì kuàilè! Zhēn gāoxìng!", "grammar": ["G1-12"]},
    {"id": "L1-170", "level": 1, "round": 2, "text": "小狗跳得很高。", "pinyin": "xiǎo gǒu tiào de hěn gāo.", "grammar": ["G1-13"]},
    {"id": "L1-171", "level": 1, "round": 2, "text": "这家店卖水果，也卖牛奶。", "pinyin": "zhè jiā diàn mài shuǐguǒ, yě mài niúnǎi.", "grammar": ["G1-16"]},
    {"id": "L1-172", "level": 1, "round": 2, "text": "他出去了。", "pinyin": "tā chūqù le.", "grammar": ["G1-29"]},
    {"id": "L1-173", "level": 1, "round": 2, "text": "我会读这个字。", "pinyin": "wǒ huì dú zhè ge zì.", "grammar": ["G1-31"]},
    {"id": "L1-174", "level": 1, "round": 2, "text": "他走得很慢。", "pinyin": "tā zǒu de hěn màn.", "grammar": ["G1-13"]},
    {"id": "L1-175", "level": 1, "round": 2, "text": "你跟谁一起去？", "pinyin": "nǐ gēn shéi yìqǐ qù?", "grammar": ["G1-26", "G1-04", "G1-22"]},
    {"id": "L1-176", "level": 1, "round": 2, "text": "请关门。", "pinyin": "qǐng guān mén.", "grammar": ["G1-09"]},
    {"id": "L1-177", "level": 1, "round": 2, "text": "今天我很高兴。", "pinyin": "jīntiān wǒ hěn gāoxìng.", "grammar": ["G1-23", "G1-13"]},
    {"id": "L1-178", "level": 1, "round": 2, "text": "我的学校在东边。", "pinyin": "wǒ de xuéxiào zài dōngbian.", "grammar": ["G1-28"]},
    {"id": "L1-179", "level": 1, "round": 2, "text": "现在八点二十。", "pinyin": "xiànzài bā diǎn èrshí.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-180", "level": 1, "round": 2, "text": "他买的东西不少。", "pinyin": "tā mǎi de dōngxi bù shǎo.", "grammar": ["G1-28", "G1-14"]},
    {"id": "L1-181", "level": 1, "round": 2, "text": "他是我的好朋友。", "pinyin": "tā shì wǒ de hǎo péngyou.", "grammar": ["G1-01", "G1-28"]},
    {"id": "L1-182", "level": 1, "round": 2, "text": "我有弟弟和妹妹。", "pinyin": "wǒ yǒu dìdi hé mèimei.", "grammar": ["G1-02", "G1-27"]},
    {"id": "L1-183", "level": 1, "round": 2, "text": "你说得对。", "pinyin": "nǐ shuō de duì.", "grammar": ["G1-26"]},
    {"id": "L1-184", "level": 1, "round": 2, "text": "请坐，请喝茶。", "pinyin": "qǐng zuò, qǐng hē chá.", "grammar": ["G1-09"]},
    {"id": "L1-185", "level": 1, "round": 2, "text": "再给我一杯水。", "pinyin": "zài gěi wǒ yì bēi shuǐ.", "grammar": ["G1-20", "G1-41", "G1-35"]},
    {"id": "L1-186", "level": 1, "round": 2, "text": "再吃一碗米饭吧。", "pinyin": "zài chī yì wǎn mǐfàn ba.", "grammar": ["G1-20", "G1-35"]},
    {"id": "L1-187", "level": 1, "round": 2, "text": "我买了一条鱼。", "pinyin": "wǒ mǎi le yì tiáo yú.", "grammar": ["G1-29", "G1-35"]},
    {"id": "L1-188", "level": 1, "round": 2, "text": "我很喜欢吃水果。", "pinyin": "wǒ hěn xǐhuan chī shuǐguǒ.", "grammar": ["G1-13"]},
    {"id": "L1-189", "level": 1, "round": 2, "text": "他唱歌很好听。", "pinyin": "tā chàng gē hěn hǎotīng.", "grammar": ["G1-13"]},
    {"id": "L1-190", "level": 1, "round": 2, "text": "他很晚才睡觉。", "pinyin": "tā hěn wǎn cái shuìjiào.", "grammar": ["G1-19"]},
    {"id": "L1-191", "level": 1, "round": 2, "text": "你要哪一个？", "pinyin": "nǐ yào nǎ yí ge?", "grammar": ["G1-07", "G1-33", "G1-35"]},
    {"id": "L1-192", "level": 1, "round": 2, "text": "我很好，你妈妈呢？", "pinyin": "wǒ hěn hǎo, nǐ māma ne?", "grammar": ["G1-08", "G1-13"]},
    {"id": "L1-193", "level": 1, "round": 2, "text": "别喝了，你应该睡觉。", "pinyin": "bié hē le, nǐ yīnggāi shuìjiào.", "grammar": ["G1-10", "G1-34"]},
    {"id": "L1-194", "level": 1, "round": 2, "text": "第五课很难。", "pinyin": "dì-wǔ kè hěn nán.", "grammar": ["G1-36", "G1-13"]},
    {"id": "L1-195", "level": 1, "round": 2, "text": "真好吃啊！", "pinyin": "zhēn hǎochī a!", "grammar": ["G1-12"]},
    {"id": "L1-196", "level": 1, "round": 2, "text": "走吧，别晚了。", "pinyin": "zǒu ba, bié wǎn le.", "grammar": ["G1-10", "G1-29"]},
    {"id": "L1-197", "level": 1, "round": 2, "text": "我跟同学一起回家。", "pinyin": "wǒ gēn tóngxué yìqǐ huí jiā.", "grammar": ["G1-26", "G1-22"]},
    {"id": "L1-198", "level": 1, "round": 2, "text": "那是谁的书？", "pinyin": "nà shì shéi de shū?", "grammar": ["G1-04", "G1-28"]},
    {"id": "L1-199", "level": 1, "round": 2, "text": "请开门。", "pinyin": "qǐng kāi mén.", "grammar": ["G1-09"]},
    {"id": "L1-200", "level": 1, "round": 2, "text": "门外面有一只小猫。", "pinyin": "mén wàimian yǒu yì zhī xiǎo māo.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-201", "level": 1, "round": 2, "text": "这只猫，它很可爱。", "pinyin": "zhè zhī māo, tā hěn kě'ài.", "grammar": ["G1-35", "G1-13"]},
    {"id": "L1-202", "level": 1, "round": 2, "text": "我有一只猫，它是白的。", "pinyin": "wǒ yǒu yì zhī māo, tā shì bái de.", "grammar": ["G1-02", "G1-35", "G1-01"]},
    {"id": "L1-203", "level": 1, "round": 2, "text": "那本旧书是我的。", "pinyin": "nà běn jiù shū shì wǒ de.", "grammar": ["G1-01", "G1-35"]},
    {"id": "L1-204", "level": 1, "round": 2, "text": "我的鞋很旧。", "pinyin": "wǒ de xié hěn jiù.", "grammar": ["G1-13"]},
    {"id": "L1-205", "level": 1, "round": 2, "text": "我要一支笔。", "pinyin": "wǒ yào yì zhī bǐ.", "grammar": ["G1-33", "G1-35"]},
    {"id": "L1-206", "level": 1, "round": 2, "text": "一月很冷。", "pinyin": "yīyuè hěn lěng.", "grammar": ["G1-13"]},
    {"id": "L1-207", "level": 1, "round": 2, "text": "现在六点。", "pinyin": "xiànzài liù diǎn.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-208", "level": 1, "round": 2, "text": "六月很热。", "pinyin": "liùyuè hěn rè.", "grammar": ["G1-13"]},
    {"id": "L1-209", "level": 1, "round": 2, "text": "我爸爸才五十八岁。", "pinyin": "wǒ bàba cái wǔshíbā suì.", "grammar": ["G1-19"]},
    {"id": "L1-210", "level": 1, "round": 2, "text": "他有八本书。", "pinyin": "tā yǒu bā běn shū.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-211", "level": 1, "round": 2, "text": "现在八点半。", "pinyin": "xiànzài bā diǎn bàn.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-212", "level": 1, "round": 2, "text": "我们学校有九个外国人。", "pinyin": "wǒmen xuéxiào yǒu jiǔ ge wàiguórén.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-213", "level": 1, "round": 2, "text": "明天见，王先生！", "pinyin": "míngtiān jiàn, Wáng xiānsheng!", "grammar": ["G1-23"]},
    {"id": "L1-214", "level": 1, "round": 2, "text": "我的朋友会游泳。", "pinyin": "wǒ de péngyou huì yóuyǒng.", "grammar": ["G1-31", "G1-28"]},
    {"id": "L1-215", "level": 1, "round": 2, "text": "他弟弟会开汽车。", "pinyin": "tā dìdi huì kāi qìchē.", "grammar": ["G1-31"]},
    {"id": "L1-216", "level": 1, "round": 2, "text": "这条鱼太大了！", "pinyin": "zhè tiáo yú tài dà le!", "grammar": ["G1-11", "G1-35"]},
    {"id": "L1-217", "level": 1, "round": 2, "text": "再来一杯咖啡。", "pinyin": "zài lái yì bēi kāfēi.", "grammar": ["G1-20", "G1-35"]},
    {"id": "L1-218", "level": 1, "round": 2, "text": "他坐汽车去找同学。", "pinyin": "tā zuò qìchē qù zhǎo tóngxué.", "grammar": ["G1-40"]},
    {"id": "L1-219", "level": 1, "round": 2, "text": "老师说话很慢。", "pinyin": "lǎoshī shuōhuà hěn màn.", "grammar": ["G1-13"]},
    {"id": "L1-220", "level": 1, "round": 2, "text": "今天妈妈很忙。", "pinyin": "jīntiān māma hěn máng.", "grammar": ["G1-23", "G1-13"]},
    {"id": "L1-221", "level": 1, "round": 2, "text": "你忙吗？", "pinyin": "nǐ máng ma?", "grammar": ["G1-03"]},
    {"id": "L1-222", "level": 1, "round": 2, "text": "他今天不能来。", "pinyin": "tā jīntiān bù néng lái.", "grammar": ["G1-32", "G1-14"]},
    {"id": "L1-223", "level": 1, "round": 2, "text": "新来的老师很好。", "pinyin": "xīn lái de lǎoshī hěn hǎo.", "grammar": ["G1-28", "G1-13"]},
    {"id": "L1-224", "level": 1, "round": 2, "text": "晚上好！", "pinyin": "wǎnshang hǎo!", "grammar": ["G1-23"]},
    {"id": "L1-225", "level": 1, "round": 2, "text": "中午我们吃什么？", "pinyin": "zhōngwǔ wǒmen chī shénme?", "grammar": ["G1-23", "G1-04"]},
    {"id": "L1-226", "level": 1, "round": 2, "text": "上午他在家。", "pinyin": "shàngwǔ tā zài jiā.", "grammar": ["G1-23"]},
    {"id": "L1-227", "level": 1, "round": 2, "text": "现在十二点二十分。", "pinyin": "xiànzài shí'èr diǎn èrshí fēn.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-228", "level": 1, "round": 2, "text": "他到学校了。", "pinyin": "tā dào xuéxiào le.", "grammar": ["G1-29"]},
    {"id": "L1-229", "level": 1, "round": 2, "text": "北京很大。", "pinyin": "Běijīng hěn dà.", "grammar": ["G1-13"]},
    {"id": "L1-230", "level": 1, "round": 2, "text": "银行就在车站后边。", "pinyin": "yínháng jiù zài chēzhàn hòubian.", "grammar": ["G1-18"]},
    {"id": "L1-231", "level": 1, "round": 2, "text": "他在后面睡觉。", "pinyin": "tā zài hòumian shuìjiào.", "grammar": ["G1-24"]},
    {"id": "L1-232", "level": 1, "round": 2, "text": "左边的猫是我的。", "pinyin": "zuǒbian de māo shì wǒ de.", "grammar": ["G1-28", "G1-01"]},
    {"id": "L1-233", "level": 1, "round": 2, "text": "右边的包是你的。", "pinyin": "yòubian de bāo shì nǐ de.", "grammar": ["G1-28", "G1-01"]},
    {"id": "L1-234", "level": 1, "round": 2, "text": "下一站请下车。", "pinyin": "xià yí zhàn qǐng xià chē.", "grammar": ["G1-09"]},
    {"id": "L1-235", "level": 1, "round": 2, "text": "公园前边有一家饭馆。", "pinyin": "gōngyuán qiánbian yǒu yì jiā fànguǎn.", "grammar": ["G1-02"]},
    {"id": "L1-236", "level": 1, "round": 2, "text": "哪个是你的？", "pinyin": "nǎ ge shì nǐ de?", "grammar": ["G1-07", "G1-28"]},
    {"id": "L1-237", "level": 1, "round": 2, "text": "每天我们读汉语。", "pinyin": "měitiān wǒmen dú Hànyǔ.", "grammar": ["G1-23"]},
    {"id": "L1-238", "level": 1, "round": 2, "text": "他从早上忙到晚上。", "pinyin": "tā cóng zǎoshang máng dào wǎnshang.", "grammar": ["G1-25"]},
    {"id": "L1-239", "level": 1, "round": 2, "text": "他今天又来了。", "pinyin": "tā jīntiān yòu lái le.", "grammar": ["G1-20", "G1-29"]},
    {"id": "L1-240", "level": 1, "round": 2, "text": "妈妈又买衣服了。", "pinyin": "māma yòu mǎi yīfu le.", "grammar": ["G1-20", "G1-29"]},
    {"id": "L1-241", "level": 1, "round": 2, "text": "右边有一家商店。", "pinyin": "yòubian yǒu yì jiā shāngdiàn.", "grammar": ["G1-02"]},
    {"id": "L1-242", "level": 1, "round": 2, "text": "我很喜欢听中国歌。", "pinyin": "wǒ hěn xǐhuan tīng Zhōngguó gē.", "grammar": ["G1-13"]},
    {"id": "L1-243", "level": 1, "round": 2, "text": "上课了，请听老师说。", "pinyin": "shàng kè le, qǐng tīng lǎoshī shuō.", "grammar": ["G1-09", "G1-29"]},
    {"id": "L1-244", "level": 1, "round": 2, "text": "四月天气很好。", "pinyin": "sìyuè tiānqì hěn hǎo.", "grammar": ["G1-13"]},
    {"id": "L1-245", "level": 1, "round": 2, "text": "我们班有四个老师。", "pinyin": "wǒmen bān yǒu sì ge lǎoshī.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-246", "level": 1, "round": 2, "text": "我有四本汉语书。", "pinyin": "wǒ yǒu sì běn Hànyǔ shū.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-247", "level": 1, "round": 2, "text": "他说得对。", "pinyin": "tā shuō de duì.", "grammar": ["G1-26"]},
    {"id": "L1-248", "level": 1, "round": 2, "text": "商店里人不多，东西不少。", "pinyin": "shāngdiàn li rén bù duō, dōngxi bù shǎo.", "grammar": ["G1-14"]},
    {"id": "L1-249", "level": 1, "round": 2, "text": "你的左边有什么？", "pinyin": "nǐ de zuǒbian yǒu shénme?", "grammar": ["G1-04", "G1-28"]},
    {"id": "L1-250", "level": 1, "round": 2, "text": "明天你能来吗？", "pinyin": "míngtiān nǐ néng lái ma?", "grammar": ["G1-32", "G1-03"]},
    {"id": "L1-251", "level": 1, "round": 2, "text": "我们星期六见。", "pinyin": "wǒmen xīngqīliù jiàn.", "grammar": ["G1-38"]}
  ]
}
