{
  "items": [
    {"id": "L1-001", "level": 1, "round": 1, "text": "我姓王，你姓什么？", "pinyin": "wǒ xìng Wáng, nǐ xìng shénme?", "grammar": ["G1-04"]},
    {"id": "L1-002", "level": 1, "round": 1, "text": "我是学生。", "pinyin": "wǒ shì xuésheng.", "grammar": ["G1-01"]},
    {"id": "L1-003", "level": 1, "round": 1, "text": "我是中国人，我学汉语。", "pinyin": "wǒ shì Zhōngguórén, wǒ xué Hànyǔ.", "grammar": ["G1-01"]},
    {"id": "L1-004", "level": 1, "round": 1, "text": "很高兴认识你。", "pinyin": "hěn gāoxìng rènshi nǐ.", "grammar": ["G1-13"]},
    {"id": "L1-005", "level": 1, "round": 1, "text": "你好吗？我很好。", "pinyin": "nǐ hǎo ma? Wǒ hěn hǎo.", "grammar": ["G1-03", "G1-13"]},
    {"id": "L1-006", "level": 1, "round": 1, "text": "我很好，你呢？", "pinyin": "wǒ hěn hǎo, nǐ ne?", "grammar": ["G1-08", "G1-13"]},
    {"id": "L1-007", "level": 1, "round": 1, "text": "谢谢你，不客气。", "pinyin": "xièxie nǐ, bú kèqi.", "grammar": ["G1-14"]},
    {"id": "L1-008", "level": 1, "round": 1, "text": "对不起，没关系。", "pinyin": "duìbuqǐ, méi guānxi.", "grammar": ["G1-14"]},
    {"id": "L1-009", "level": 1, "round": 1, "text": "明天见，同学们！", "pinyin": "míngtiān jiàn, tóngxuémen!", "grammar": ["G1-23"]},
    {"id": "L1-010", "level": 1, "round": 1, "text": "喂？请问，王老师在吗？", "pinyin": "wéi? Qǐngwèn, Wáng lǎoshī zài ma?", "grammar": ["G1-03", "G1-09"]},
    {"id": "L1-011", "level": 1, "round": 1, "text": "请进！请坐！", "pinyin": "qǐng jìn! Qǐng zuò!", "grammar": ["G1-09"]},
    {"id": "L1-012", "level": 1, "round": 1, "text": "这是我的朋友。", "pinyin": "zhè shì wǒ de péngyou.", "grammar": ["G1-01", "G1-28"]},
    {"id": "L1-013", "level": 1, "round": 1, "text": "我家有五个人。", "pinyin": "wǒ jiā yǒu wǔ ge rén.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-014", "level": 1, "round": 1, "text": "我爸爸是医生，我妈妈是老师。", "pinyin": "wǒ bàba shì yīshēng, wǒ māma shì lǎoshī.", "grammar": ["G1-01"]},
    {"id": "L1-015", "level": 1, "round": 1, "text": "我有一个哥哥和一个姐姐。", "pinyin": "wǒ yǒu yí ge gēge hé yí ge jiějie.", "grammar": ["G1-02", "G1-35", "G1-27"]},
    {"id": "L1-016", "level": 1, "round": 1, "text": "我的弟弟很小，他很可爱。", "pinyin": "wǒ dìdi hěn xiǎo, tā hěn kě'ài.", "grammar": ["G1-13", "G1-28"]},
    {"id": "L1-017", "level": 1, "round": 1, "text": "你妈妈忙不忙？", "pinyin": "nǐ māma máng bu máng?", "grammar": ["G1-05"]},
    {"id": "L1-018", "level": 1, "round": 1, "text": "她是王老师的女儿。", "pinyin": "tā shì Wáng lǎoshī de nǚ'ér.", "grammar": ["G1-01", "G1-28"]},
    {"id": "L1-019", "level": 1, "round": 1, "text": "今年我奶奶七十八岁。", "pinyin": "jīnnián wǒ nǎinai qīshíbā suì.", "grammar": ["G1-23"]},
    {"id": "L1-020", "level": 1, "round": 1, "text": "我儿子二十岁了。", "pinyin": "wǒ ér'zi èrshí suì le.", "grammar": ["G1-29"]},
    {"id": "L1-021", "level": 1, "round": 1, "text": "你家有几个人？", "pinyin": "nǐ jiā yǒu jǐ ge rén?", "grammar": ["G1-02", "G1-06"]},
    {"id": "L1-022", "level": 1, "round": 1, "text": "我们都是中国人。", "pinyin": "wǒmen dōu shì Zhōngguórén.", "grammar": ["G1-17", "G1-01"]},
    {"id": "L1-023", "level": 1, "round": 1, "text": "现在十点十分。", "pinyin": "xiànzài shí diǎn shí fēn.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-024", "level": 1, "round": 1, "text": "早上七点我就起。", "pinyin": "zǎoshang qī diǎn wǒ jiù qǐ.", "grammar": ["G1-23", "G1-37", "G1-18"]},
    {"id": "L1-025", "level": 1, "round": 1, "text": "中午十二点我们吃饭。", "pinyin": "zhōngwǔ shí'èr diǎn wǒmen chīfàn.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-026", "level": 1, "round": 1, "text": "今天星期三，明天星期四。", "pinyin": "jīntiān xīngqīsān, míngtiān xīngqīsì.", "grammar": ["G1-23", "G1-38"]},
    {"id": "L1-027", "level": 1, "round": 1, "text": "今天几号？", "pinyin": "jīntiān jǐ hào?", "grammar": ["G1-23", "G1-06"]},
    {"id": "L1-028", "level": 1, "round": 1, "text": "明天是我的生日。", "pinyin": "míngtiān shì wǒ de shēngrì.", "grammar": ["G1-23", "G1-01", "G1-28"]},
    {"id": "L1-029", "level": 1, "round": 1, "text": "我来中国三年了。", "pinyin": "wǒ lái Zhōngguó sān nián le.", "grammar": ["G1-38", "G1-29"]},
    {"id": "L1-030", "level": 1, "round": 1, "text": "每天我学习两小时汉语。", "pinyin": "měitiān wǒ xuéxí liǎng xiǎoshí Hànyǔ.", "grammar": ["G1-23"]},
    {"id": "L1-031", "level": 1, "round": 1, "text": "我七点半吃早饭。", "pinyin": "wǒ qī diǎn bàn chī zǎofàn.", "grammar": ["G1-37"]},
    {"id": "L1-032", "level": 1, "round": 1, "text": "现在几点？", "pinyin": "xiànzài jǐ diǎn?", "grammar": ["G1-23", "G1-06"]},
    {"id": "L1-033", "level": 1, "round": 1, "text": "我在学校学习汉语。", "pinyin": "wǒ zài xuéxiào xuéxí Hànyǔ.", "grammar": ["G1-24"]},
    {"id": "L1-034", "level": 1, "round": 1, "text": "我的学校很大，学生很多。", "pinyin": "wǒ de xuéxiào hěn dà, xuésheng hěn duō.", "grammar": ["G1-13", "G1-28"]},
    {"id": "L1-035", "level": 1, "round": 1, "text": "今天我们上第五课。", "pinyin": "jīntiān wǒmen shàng dì-wǔ kè.", "grammar": ["G1-23", "G1-36"]},
    {"id": "L1-036", "level": 1, "round": 1, "text": "王老师教我们汉语。", "pinyin": "Wáng lǎoshī jiāo wǒmen Hànyǔ.", "grammar": ["G1-41"]},
    {"id": "L1-037", "level": 1, "round": 1, "text": "我的同学都很友好。", "pinyin": "wǒ de tóngxué dōu hěn yǒuhǎo.", "grammar": ["G1-28", "G1-17", "G1-13"]},
    {"id": "L1-038", "level": 1, "round": 1, "text": "教室里有二十个学生。", "pinyin": "jiàoshì li yǒu èrshí ge xuésheng.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-039", "level": 1, "round": 1, "text": "汉语难不难？", "pinyin": "Hànyǔ nán bu nán?", "grammar": ["G1-05"]},
    {"id": "L1-040", "level": 1, "round": 1, "text": "我会一点儿汉语。", "pinyin": "wǒ huì yìdiǎnr Hànyǔ.", "grammar": ["G1-31"]},
    {"id": "L1-041", "level": 1, "round": 1, "text": "这个多少钱？", "pinyin": "zhè ge duōshao qián?", "grammar": ["G1-06"]},
    {"id": "L1-042", "level": 1, "round": 1, "text": "这个十块钱。", "pinyin": "zhè ge shí kuài qián.", "grammar": ["G1-39", "G1-35"]},
    {"id": "L1-043", "level": 1, "round": 1, "text": "我买了三个苹果。", "pinyin": "wǒ mǎi le sān ge píngguǒ.", "grammar": ["G1-35", "G1-29"]},
    {"id": "L1-044", "level": 1, "round": 1, "text": "从我家到商店很近。", "pinyin": "cóng wǒ jiā dào shāngdiàn hěn jìn.", "grammar": ["G1-25"]},
    {"id": "L1-045", "level": 1, "round": 1, "text": "我去商店买东西。", "pinyin": "wǒ qù shāngdiàn mǎi dōngxi.", "grammar": ["G1-40"]},
    {"id": "L1-046", "level": 1, "round": 1, "text": "这个西瓜太大了！", "pinyin": "zhè ge xīguā tài dà le!", "grammar": ["G1-11"]},
    {"id": "L1-047", "level": 1, "round": 1, "text": "我要一杯咖啡。", "pinyin": "wǒ yào yì bēi kāfēi.", "grammar": ["G1-33", "G1-35"]},
    {"id": "L1-048", "level": 1, "round": 1, "text": "请给我一碗面条。", "pinyin": "qǐng gěi wǒ yì wǎn miàntiáo.", "grammar": ["G1-09", "G1-41", "G1-35"]},
    {"id": "L1-049", "level": 1, "round": 1, "text": "我不喝牛奶，我喝茶。", "pinyin": "wǒ bù hē niúnǎi, wǒ hē chá.", "grammar": ["G1-14"]},
    {"id": "L1-050", "level": 1, "round": 1, "text": "妈妈做的饭很好吃。", "pinyin": "māma zuò de fàn hěn hǎochī.", "grammar": ["G1-28", "G1-13"]},
    {"id": "L1-051", "level": 1, "round": 1, "text": "你饿不饿？", "pinyin": "nǐ è bu è?", "grammar": ["G1-05"]},
    {"id": "L1-052", "level": 1, "round": 1, "text": "我渴了，我想喝水。", "pinyin": "wǒ kě le, wǒ xiǎng hē shuǐ.", "grammar": ["G1-29", "G1-33"]},
    {"id": "L1-053", "level": 1, "round": 1, "text": "这些水果很好。", "pinyin": "zhèxiē shuǐguǒ hěn hǎo.", "grammar": ["G1-13"]},
    {"id": "L1-054", "level": 1, "round": 1, "text": "今天天气很好。", "pinyin": "jīntiān tiānqì hěn hǎo.", "grammar": ["G1-23", "G1-13"]},
    {"id": "L1-055", "level": 1, "round": 1, "text": "昨天下雨了，今天天晴了。", "pinyin": "zuótiān xià yǔ le, jīntiān tiān qíng le.", "grammar": ["G1-23", "G1-29"]},
    {"id": "L1-056", "level": 1, "round": 1, "text": "冬天很冷，夏天很热。", "pinyin": "dōngtiān hěn lěng, xiàtiān hěn rè.", "grammar": ["G1-13"]},
    {"id": "L1-057", "level": 1, "round": 1, "text": "外边风很大。", "pinyin": "wàibian fēng hěn dà.", "grammar": ["G1-13"]},
    {"id": "L1-058", "level": 1, "round": 1, "text": "春天不冷也不热。", "pinyin": "chūntiān bù lěng yě bú rè.", "grammar": ["G1-14", "G1-16"]},
    {"id": "L1-059", "level": 1, "round": 1, "text": "他在北京工作。", "pinyin": "tā zài Běijīng gōngzuò.", "grammar": ["G1-24"]},
    {"id": "L1-060", "level": 1, "round": 1, "text": "我的家在学校旁边。", "pinyin": "wǒ de jiā zài xuéxiào pángbian.", "grammar": ["G1-28"]},
    {"id": "L1-061", "level": 1, "round": 1, "text": "银行在哪儿？", "pinyin": "yínháng zài nǎr?", "grammar": ["G1-04", "G1-07"]},
    {"id": "L1-062", "level": 1, "round": 1, "text": "汽车站就在商店旁边。", "pinyin": "qìchēzhàn jiù zài shāngdiàn pángbian.", "grammar": ["G1-18"]},
    {"id": "L1-063", "level": 1, "round": 1, "text": "从家到学校要走十分钟。", "pinyin": "cóng jiā dào xuéxiào yào zǒu shí fēnzhōng.", "grammar": ["G1-25"]},
    {"id": "L1-064", "level": 1, "round": 1, "text": "我家前面有一个公园。", "pinyin": "wǒ jiā qiánmian yǒu yí ge gōngyuán.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-065", "level": 1, "round": 1, "text": "学校里有很多学生。", "pinyin": "xuéxiào li yǒu hěn duō xuésheng.", "grammar": ["G1-02", "G1-13"]},
    {"id": "L1-066", "level": 1, "round": 1, "text": "他在家看电视。", "pinyin": "tā zài jiā kàn diànshì.", "grammar": ["G1-24"]},
    {"id": "L1-067", "level": 1, "round": 1, "text": "每天我七点起。", "pinyin": "měitiān wǒ qī diǎn qǐ.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-068", "level": 1, "round": 1, "text": "晚上我十点睡觉。", "pinyin": "wǎnshang wǒ shí diǎn shuìjiào.", "grammar": ["G1-23", "G1-37"]},
    {"id": "L1-069", "level": 1, "round": 1, "text": "他洗手了。", "pinyin": "tā xǐ shǒu le.", "grammar": ["G1-29"]},
    {"id": "L1-070", "level": 1, "round": 1, "text": "请快一点儿！", "pinyin": "qǐng kuài yìdiǎnr!", "grammar": ["G1-09"]},
    {"id": "L1-071", "level": 1, "round": 1, "text": "我会游泳。", "pinyin": "wǒ huì yóuyǒng.", "grammar": ["G1-31"]},
    {"id": "L1-072", "level": 1, "round": 1, "text": "我们一起去公园吧。", "pinyin": "wǒmen yìqǐ qù gōngyuán ba.", "grammar": ["G1-22"]},
    {"id": "L1-073", "level": 1, "round": 1, "text": "我们去公园玩，好不好？", "pinyin": "wǒmen qù gōngyuán wán, hǎo bu hǎo?", "grammar": ["G1-05", "G1-40"]},
    {"id": "L1-074", "level": 1, "round": 1, "text": "我很喜欢看电影。", "pinyin": "wǒ hěn xǐhuan kàn diànyǐng.", "grammar": ["G1-13"]},
    {"id": "L1-075", "level": 1, "round": 1, "text": "他跑得很快。", "pinyin": "tā pǎo de hěn kuài.", "grammar": ["G1-13"]},
    {"id": "L1-076", "level": 1, "round": 1, "text": "请说慢一点儿。", "pinyin": "qǐng shuō màn yìdiǎnr.", "grammar": ["G1-09"]},
    {"id": "L1-077", "level": 1, "round": 1, "text": "我听不懂，请你再说一次。", "pinyin": "wǒ tīng bu dǒng, qǐng nǐ zài shuō yí cì.", "grammar": ["G1-14", "G1-09", "G1-20"]},
    {"id": "L1-078", "level": 1, "round": 1, "text": "你会说汉语吗？", "pinyin": "nǐ huì shuō Hànyǔ ma?", "grammar": ["G1-31", "G1-03"]},
    {"id": "L1-079", "level": 1, "round": 1, "text": "我学过两年汉语。", "pinyin": "wǒ xué guo liǎng nián Hànyǔ.", "grammar": ["G1-30", "G1-38"]},
    {"id": "L1-080", "level": 1, "round": 1, "text": "他去过一次中国。", "pinyin": "tā qù guo yí cì Zhōngguó.", "grammar": ["G1-30", "G1-35"]},
    {"id": "L1-081", "level": 1, "round": 1, "text": "别忘了你的书！", "pinyin": "bié wàng le nǐ de shū!", "grammar": ["G1-10", "G1-28"]},
    {"id": "L1-082", "level": 1, "round": 1, "text": "上课了，请进教室。", "pinyin": "shàng kè le, qǐng jìn jiàoshì.", "grammar": ["G1-29", "G1-09"]},
    {"id": "L1-083", "level": 1, "round": 1, "text": "你应该多喝水。", "pinyin": "nǐ yīnggāi duō hē shuǐ.", "grammar": ["G1-34"]},
    {"id": "L1-084", "level": 1, "round": 1, "text": "你应该早点睡。", "pinyin": "nǐ yīnggāi zǎo diǎn shuì.", "grammar": ["G1-34"]},
    {"id": "L1-085", "level": 1, "round": 1, "text": "太好了，谢谢！", "pinyin": "tài hǎo le, xièxie!", "grammar": ["G1-11"]},
    {"id": "L1-086", "level": 1, "round": 1, "text": "她真漂亮！", "pinyin": "tā zhēn piàoliang!", "grammar": ["G1-12"]},
    {"id": "L1-087", "level": 1, "round": 1, "text": "这个电影真好看！", "pinyin": "zhè ge diànyǐng zhēn hǎokàn!", "grammar": ["G1-12"]},
    {"id": "L1-088", "level": 1, "round": 1, "text": "我还想去一次。", "pinyin": "wǒ hái xiǎng qù yí cì.", "grammar": ["G1-21", "G1-33", "G1-35"]},
    {"id": "L1-089", "level": 1, "round": 1, "text": "他又来了。", "pinyin": "tā yòu lái le.", "grammar": ["G1-20", "G1-29"]},
    {"id": "L1-090", "level": 1, "round": 1, "text": "你会唱歌吗？", "pinyin": "nǐ huì chàng gē ma?", "grammar": ["G1-31", "G1-03"]},
    {"id": "L1-091", "level": 1, "round": 1, "text": "我会唱中国歌。", "pinyin": "wǒ huì chàng Zhōngguó gē.", "grammar": ["G1-31"]},
    {"id": "L1-092", "level": 1, "round": 1, "text": "小狗在门外面玩。", "pinyin": "xiǎo gǒu zài mén wàimian wán.", "grammar": ["G1-24"]},
    {"id": "L1-093", "level": 1, "round": 1, "text": "我很喜欢小狗。", "pinyin": "wǒ hěn xǐhuan xiǎo gǒu.", "grammar": ["G1-13"]},
    {"id": "L1-094", "level": 1, "round": 1, "text": "这只小猫很白。", "pinyin": "zhè zhī xiǎo māo hěn bái.", "grammar": ["G1-13", "G1-35"]},
    {"id": "L1-095", "level": 1, "round": 1, "text": "那条大鱼多少钱？", "pinyin": "nà tiáo dà yú duōshao qián?", "grammar": ["G1-35", "G1-06"]},
    {"id": "L1-096", "level": 1, "round": 1, "text": "我能看看那件衣服吗？", "pinyin": "wǒ néng kànkan nà jiàn yīfu ma?", "grammar": ["G1-32", "G1-03"]},
    {"id": "L1-097", "level": 1, "round": 1, "text": "这件衣服太漂亮了！", "pinyin": "zhè jiàn yīfu tài piàoliang le!", "grammar": ["G1-11", "G1-35"]},
    {"id": "L1-098", "level": 1, "round": 1, "text": "我要换一件。", "pinyin": "wǒ yào huàn yí jiàn.", "grammar": ["G1-33", "G1-35"]},
    {"id": "L1-099", "level": 1, "round": 1, "text": "我的鞋旧了，我想买新的。", "pinyin": "wǒ de xié jiù le, wǒ xiǎng mǎi xīn de.", "grammar": ["G1-29", "G1-33", "G1-28"]},
    {"id": "L1-100", "level": 1, "round": 1, "text": "请给妈妈打电话。", "pinyin": "qǐng gěi māma dǎ diànhuà.", "grammar": ["G1-09", "G1-26"]},
    {"id": "L1-101", "level": 1, "round": 1, "text": "他才五岁。", "pinyin": "tā cái wǔ suì.", "grammar": ["G1-19"]},
    {"id": "L1-102", "level": 1, "round": 1, "text": "我跟妈妈去商店。", "pinyin": "wǒ gēn māma qù shāngdiàn.", "grammar": ["G1-26"]},
    {"id": "L1-103", "level": 1, "round": 1, "text": "爸爸和妈妈都很好。", "pinyin": "bàba hé māma dōu hěn hǎo.", "grammar": ["G1-27", "G1-17", "G1-13"]},
    {"id": "L1-104", "level": 1, "round": 1, "text": "服务员，来一碗米饭。", "pinyin": "fúwùyuán, lái yì wǎn mǐfàn.", "grammar": ["G1-35"]},
    {"id": "L1-105", "level": 1, "round": 1, "text": "小姐，这是什么菜？", "pinyin": "xiǎojiě, zhè shì shénme cài?", "grammar": ["G1-04"]},
    {"id": "L1-106", "level": 1, "round": 1, "text": "喂，你是谁？", "pinyin": "wéi, nǐ shì shéi?", "grammar": ["G1-04"]},
    {"id": "L1-107", "level": 1, "round": 1, "text": "每天我坐汽车去学校。", "pinyin": "měitiān wǒ zuò qìchē qù xuéxiào.", "grammar": ["G1-23"]},
    {"id": "L1-108", "level": 1, "round": 1, "text": "今天很热。", "pinyin": "jīntiān hěn rè.", "grammar": ["G1-23", "G1-13"]},
    {"id": "L1-109", "level": 1, "round": 1, "text": "我很累。", "pinyin": "wǒ hěn lèi.", "grammar": ["G1-13"]},
    {"id": "L1-110", "level": 1, "round": 1, "text": "冬天太冷了！", "pinyin": "dōngtiān tài lěng le!", "grammar": ["G1-11"]},
    {"id": "L1-111", "level": 1, "round": 1, "text": "教室里有两个老师。", "pinyin": "jiàoshì li yǒu liǎng ge lǎoshī.", "grammar": ["G1-02", "G1-35"]},
    {"id": "L1-112", "level": 1, "round": 1, "text": "请慢走！", "pinyin": "qǐng màn zǒu!", "grammar": ["G1-09"]},
    {"id": "L1-113", "level": 1, "round": 1, "text": "你为什么学汉语？", "pinyin": "nǐ wèi shénme xué Hànyǔ?", "grammar": ["G1-04"]},
    {"id": "L1-114", "level": 1, "round": 1, "text": "这个字怎么读？", "pinyin": "zhè ge zì zěnme dú?", "grammar": ["G1-04"]},
    {"id": "L1-115", "level": 1, "round": 1, "text": "他没来。", "pinyin": "tā méi lái.", "grammar": ["G1-15"]},
    {"id": "L1-116", "level": 1, "round": 1, "text": "今天我没在家。", "pinyin": "jīntiān wǒ méi zài jiā.", "grammar": ["G1-15"]},
    {"id": "L1-117", "level": 1, "round": 1, "text": "他也喜欢游泳。", "pinyin": "tā yě xǐhuan yóuyǒng.", "grammar": ["G1-16"]},
    {"id": "L1-118", "level": 1, "round": 1, "text": "我也很喜欢中国菜。", "pinyin": "wǒ yě hěn xǐhuan Zhōngguó cài.", "grammar": ["G1-16", "G1-13"]},
    {"id": "L1-119", "level": 1, "round": 1, "text": "我妹妹才三岁。", "pinyin": "wǒ mèimei cái sān suì.", "grammar": ["G1-19"]},
    {"id": "L1-120", "level": 1, "round": 1, "text": "他还没来。", "pinyin": "tā hái méi lái.", "grammar": ["G1-21", "G1-15"]},
    {"id": "L1-121", "level": 1, "round": 1, "text": "你还喝吗？", "pinyin": "nǐ hái hē ma?", "grammar": ["G1-21", "G1-03"]},
    {"id": "L1-122", "level": 1, "round": 1, "text": "我和同学一起去商店。", "pinyin": "wǒ hé tóngxué yìqǐ qù shāngdiàn.", "grammar": ["G1-22", "G1-27"]},
    {"id": "L1-123", "level": 1, "round": 1, "text": "我可以进来吗？", "pinyin": "wǒ kěyǐ jìnlái ma?", "grammar": ["G1-32", "G1-03"]}
  ]
}
