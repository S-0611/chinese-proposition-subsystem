  "name": "指示代词:这、那、这儿、那儿、这里、那里、这些、那些、别的、有的",
  "pattern": "(这|那|别的|有的)",
  "pattern_source": "keep"
 },
 {
  "id": "G1-07",
  "name": "数词:一、二/两、三…九、零；十、百；半",
  "pattern": "[一二两三四五六七八九十百零半]",
  "pattern_source": "keep"
 },
 {
  "id": "G1-08",
  "name": "名量词:杯、本、个、家、间、口、块、页",
  "pattern": "[杯本个家间口块页]",
  "pattern_source": "keep"
 },
 {
  "id": "G1-09",
  "name": "程度副词:非常、很、太、真、最",
  "pattern": "(非常|很|太|真|最)",
  "pattern_source": "keep"
 },
 {
  "id": "G1-10",
