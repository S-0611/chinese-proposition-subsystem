  "pattern": "(上|下|里|外|前|后|左|右|东|南|西|北)(边|面)?",
  "pattern_source": "keep"
 },
 {
  "id": "G1-02",
  "name": "能愿动词:会、能",
  "pattern": "(会|能)",
  "pattern_source": "keep"
 },
 {
  "id": "G1-03",
  "name": "能愿动词:想、要",
  "pattern": "(想|要)",
  "pattern_source": "keep"
 },
 {
  "id": "G1-04",
  "name": "疑问代词:多、多少、几、哪、哪儿、哪里、哪些、什么、谁、怎么",
  "pattern": "(多|多少|几|哪|什么|谁|怎么)",
  "pattern_source": "keep"
 },
 {
  "id": "G1-05",
  "name": "人称代词:我、你、您、他、她、我们、你们、他们、她们",
  "pattern": "(我|你|您|他|她|我们|你们|他们|她们)",
  "pattern_source": "keep-fail"
 },
 {
