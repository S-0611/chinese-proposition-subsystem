  "name": "时间副词:马上、先、有时、在、正、正在",
  "pattern": "(马上|先|有时|正在|正)",
  "pattern_source": "keep"
 },
 {
  "id": "G1-12",
  "name": "频率、重复副词:常、常常、再",
  "pattern": "(常|再)",
  "pattern_source": "keep"
 },
 {
