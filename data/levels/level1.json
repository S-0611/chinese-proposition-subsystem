  "grammar": [
    {
      "id": "G1-01",
      "name": "“是”字句",
      "pattern": "是",
      "desc": "主语＋是＋名词，如：我是学生。"
    },
    {
      "id": "G1-02",
      "name": "“有”字句",
      "pattern": "有",
      "desc": "表拥有或存在，如：我有一个哥哥。"
    },
    {
      "id": "G1-03",
      "name": "“吗”是非问",
      "pattern": "吗？",
      "desc": "你是学生吗？"
    },
    {
      "id": "G1-04",
      "name": "疑问代词问句",
      "pattern": "(谁|什么|哪儿|哪里|为什么|怎么)",
      "desc": "你是哪国人？"
    },
    {
      "id": "G1-05",
      "name": "正反问",
      "pattern": "(是不是|有没有|好不好|行不行|去不去|来不来|吃不吃|喝不喝|买不买|看不看|忙不忙|热不热|冷不冷|大不大|多不多|难不难|对不对|饿不饿|渴不渴|远不远|近不近|新不新|学不学)",
      "desc": "你忙不忙？"
    },
    {
      "id": "G1-06",
      "name": "“几／多少”问数量",
      "pattern": "(几|多少)",
      "desc": "你家有几口人？"
    },
    {
      "id": "G1-07",
      "name": "“哪”特指问",
      "pattern": "哪",
      "desc": "哪个是你的？"
    },
    {
      "id": "G1-08",
      "name": "“呢”省略式问句",
      "pattern": "呢？",
      "desc": "我很好，你呢？"
    },
    {
      "id": "G1-09",
      "name": "祈使句“请……”",
      "pattern": "请",
      "desc": "请进！"
    },
    {
      "id": "G1-10",
      "name": "禁止“别／不要……”",
      "pattern": "(别|不要)",
      "desc": "别忘了！"
    },
    {
      "id": "G1-11",
      "name": "感叹句“太……了”",
      "pattern": "太[^，。？！]{1,6}了",
      "desc": "太好了！"
    },
    {
      "id": "G1-12",
      "name": "感叹句“真……”",
      "pattern": "真",
      "desc": "真漂亮！"
    },
    {
      "id": "G1-13",
      "name": "程度副词“很”",
      "pattern": "很",
      "desc": "我很忙。"
    },
    {
      "id": "G1-14",
      "name": "否定副词“不”",
      "pattern": "不",
      "desc": "我不去。"
    },
    {
      "id": "G1-15",
      "name": "否定副词“没（有）”",
      "pattern": "没",
      "desc": "我没看电视。"
    },
    {
      "id": "G1-16",
      "name": "副词“也”",
      "pattern": "也",
      "desc": "他也是学生。"
    },
    {
      "id": "G1-17",
      "name": "副词“都”",
      "pattern": "都",
      "desc": "我们都是中国人。"
    },
    {
      "id": "G1-18",
      "name": "副词“就”",
      "pattern": "就",
      "desc": "我就来。"
    },
    {
      "id": "G1-19",
      "name": "副词“才”",
      "pattern": "才",
      "desc": "他才知道。"
    },
    {
      "id": "G1-20",
      "name": "副词“再／又”",
      "pattern": "(再|又)",
      "desc": "再喝一杯。"
    },
    {
      "id": "G1-21",
      "name": "副词“还”",
      "pattern": "还",
      "desc": "他还在学校。"
    },
    {
      "id": "G1-22",
      "name": "副词“一起”",
      "pattern": "一起",
      "desc": "我们一起去吧。"
    },
    {
      "id": "G1-23",
      "name": "时间词作状语",
      "pattern": "^(今天|明天|昨天|现在|每天|天天|上午|下午|晚上|早上|中午|星期[一二三四五六日天]|今年|去年|明年)",
      "desc": "明天我去北京。"
    },
    {
      "id": "G1-24",
      "name": "“在＋处所＋动词”",
      "pattern": "在[^，。？！]{0,5}(学|住|工|玩|看|吃|睡|买|说|打|上|做)",
      "desc": "我在家看电视。"
    },
    {
      "id": "G1-25",
      "name": "介词“从……到……”",
      "pattern": "从[^，。？！]{1,6}到",
      "desc": "从家到学校很远。"
    },
    {
      "id": "G1-26",
      "name": "介词“给／对／跟”",
      "pattern": "(给|对|跟)",
      "desc": "我跟妈妈去商店。"
    },
    {
      "id": "G1-27",
      "name": "连词“和”",
      "pattern": "和",
      "desc": "爸爸和妈妈"
    },
    {
      "id": "G1-28",
      "name": "结构助词“的”",
      "pattern": "的",
      "desc": "我的书"
    },
    {
      "id": "G1-29",
      "name": "动态助词“了”",
      "pattern": "了",
      "desc": "我买了一本书。"
    },
    {
      "id": "G1-30",
      "name": "经历“过”",
      "pattern": ".过",
      "desc": "我去过中国。"
    },
    {
      "id": "G1-31",
      "name": "能愿动词“会”",
      "pattern": "会",
      "desc": "我会说汉语。"
    },
    {
      "id": "G1-32",
      "name": "能愿动词“能／可以”",
      "pattern": "(能|可以)",
      "desc": "可以进来吗？"
    },
    {
      "id": "G1-33",
      "name": "能愿动词“要／想”",
      "pattern": "(要|想)",
      "desc": "我想喝茶。"
    },
    {
      "id": "G1-34",
      "name": "能愿动词“应该”",
      "pattern": "应该",
      "desc": "你应该休息。"
    },
    {
      "id": "G1-35",
      "name": "数量短语（数＋量＋名）",
      "pattern": "[一二两三四五六七八九十几这那半百千万][个只本支条件杯碗块次]",
      "desc": "三本书"
    },
    {
      "id": "G1-36",
      "name": "序数“第＋数”",
      "pattern": "第[一二三四五六七八九十]",
      "desc": "第五课"
    },
    {
      "id": "G1-37",
      "name": "时刻表达（点／分／半）",
      "pattern": "[一二两三四五六七八九十]点",
      "desc": "八点半"
    },
    {
      "id": "G1-38",
      "name": "年月日与星期表达",
      "pattern": "([一二两三四五六七八九十]{1,3}年|[一二两三四五六七八九十]{1,2}月[一二两三四五六七八九十]{1,3}[号日]|星期[一二三四五六日天])",
      "desc": "九月十号"
    },
    {
      "id": "G1-39",
      "name": "钱的表达（块）",
      "pattern": "块",
      "desc": "十块钱"
    },
    {
      "id": "G1-40",
      "name": "连动句",
      "pattern": "(去|来)[^，。？！]{0,8}(买|看|吃|喝|找|学|打|玩|上)",
      "desc": "我去商店买东西。"
    },
    {
      "id": "G1-41",
      "name": "双宾句（给／送／教）",
      "pattern": "(给|送|教)[^，。？！]{0,6}(一|两|我|你|他|她|这|那)",
      "desc": "他送我一本书。"
    }
  ]
}